#!/usr/bin/env python3
"""Dolphin Converter - Orchestrateur universel de conversion de fichiers."""

import shutil
import subprocess
from pathlib import Path
from typing import Optional

class NamingResolver:
    """Gestion de la resolution des chemins et de la prevention des collisions."""

    @staticmethod
    def resolve_target_path(source_path: Path, target_format: str, output_dir: Optional[Path] = None) -> Path:
        target_ext = f".{target_format.lower().lstrip('.')}"
        directory = output_dir if output_dir is not None else source_path.parent
        new_name = f"{source_path.stem}{target_ext}"
        return directory / new_name

    @staticmethod
    def get_unique_path(target_path: Path) -> Path:
        if not target_path.exists():
            return target_path

        parent = target_path.parent
        stem = target_path.stem
        suffix = target_path.suffix

        counter = 1
        while True:
            candidate = parent / f"{stem}_{counter}{suffix}"
            if not candidate.exists():
                return candidate
            counter += 1


class Notifier:
    """Emission des notifications KDE Plasma via notify-send."""

    APP_NAME = "Dolphin Converter"

    @classmethod
    def _run_notify(cls, args: list[str]) -> None:
        if not shutil.which("notify-send"):
            return
        try:
            subprocess.run(args, check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            pass

    @classmethod
    def send_start(cls, count: int, target_format: str, silent: bool = False) -> None:
        if silent or count <= 0:
            return
        plural = "s" if count > 1 else ""
        body = f"Conversion de {count} fichier{plural} vers {target_format.upper()} en cours..."
        args = [
            "notify-send",
            "-a", cls.APP_NAME,
            "-i", "transform-browse",
            "--hint=int:transient:1",
            cls.APP_NAME,
            body
        ]
        cls._run_notify(args)

    @classmethod
    def send_success(cls, success_count: int, target_format: str, sample_file: Optional[Path] = None) -> None:
        if success_count <= 0:
            return
        title = "Conversion terminee"
        if success_count == 1 and sample_file is not None:
            body = f"Fichier converti : {sample_file.name}"
        else:
            plural = "s" if success_count > 1 else ""
            body = f"{success_count} fichier{plural} converti{plural} avec succes vers {target_format.upper()}."

        args = [
            "notify-send",
            "-a", cls.APP_NAME,
            "-i", "document-save",
            title,
            body
        ]
        cls._run_notify(args)

    @classmethod
    def send_error(cls, message: str) -> None:
        args = [
            "notify-send",
            "-a", cls.APP_NAME,
            "-i", "dialog-error",
            "-u", "critical",
            "Erreur de conversion",
            message
        ]
        cls._run_notify(args)


if __name__ == "__main__":
    pass

